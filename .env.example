# Prime Crackers Supabase
# Dashboard → Project Settings → API Keys → Publishable key (sb_publishable_…)
# Or legacy: Settings → API → anon public key
# Use the Project URL only — do NOT add /rest/v1 at the end
VITE_SUPABASE_URL=https://pewmmipyxxqfbbgqyffg.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Optional — company SMTP is configured in Supabase Dashboard (see supabase/company-smtp-setup.sql)
# Auth emails will show From: Prime Crackers <primecrackers@gmail.com> after SMTP is enabled.
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional — Google Search Console site verification meta tag content
# VITE_GOOGLE_SITE_VERIFICATION=your-verification-code-here

# Chatbot (Groq via FastAPI backend — proxied at /api/chatbot)
VITE_CHATBOT_ENABLED=true
VITE_CHATBOT_API=/api/chatbot

# Groq cloud LLM
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
AURA_LLM_PROVIDER=groq
GROQ_MAX_TOKENS=100
GROQ_TEMPERATURE=0.15
