{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "primecrackers.in" }],
      "destination": "https://www.primecracker.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.primecrackers.in" }],
      "destination": "https://www.primecracker.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "primecracker.com" }],
      "destination": "https://www.primecracker.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*\\.(webp|png|jpg|jpeg|svg|ico|woff|woff2|mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.primecracker.com/>; rel=\"canonical\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
